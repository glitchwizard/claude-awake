#!/bin/bash
# claude-awake — keep a MacBook from sleeping on lid close while Claude Code CLI runs.
#
# macOS forces sleep when the lid closes regardless of caffeinate. The only
# switch that overrides that is `pmset -a disablesleep 1` (root). This tool
# flips it on while any Claude Code CLI process is alive and back off shortly
# after they all exit, so the laptop does not stay hot in a bag forever.
#
#   claude-awake status     show switch state + whether Claude Code is running
#   claude-awake on         hold the switch on until `off` (daemon won't undo it)
#   claude-awake off        release the hold and re-enable sleep now
#   claude-awake install    write + load the LaunchAgent (prints the sudoers step if missing)
#   claude-awake uninstall  unload the LaunchAgent and re-enable sleep
#   claude-awake daemon     poll loop (run by the LaunchAgent, not by hand)
set -u
STATE_DIR="$HOME/.local/state/claude-awake"
HOLD="$STATE_DIR/hold"
LABEL="com.glitchwizard.claude-awake"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/claude-awake.log"
SUDOERS=/etc/sudoers.d/claude-awake
POLL=30          # seconds between checks
GRACE=3          # consecutive empty polls before sleep is re-enabled (~90s)
mkdir -p "$STATE_DIR"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }

sleep_disabled() {  # exit 0 = switch is ON (sleep disabled)
  pmset -g 2>/dev/null | grep -qE '^ *SleepDisabled +1'
}

have_sudo_rule() { sudo -n -l /usr/bin/pmset -a disablesleep 1 >/dev/null 2>&1; }

set_switch() {      # 1 or 0
  if sudo -n /usr/bin/pmset -a disablesleep "$1" 2>/dev/null; then
    log "disablesleep=$1"
  else
    log "ERROR: cannot run pmset without a password; install $SUDOERS (see: claude-awake install)"
    return 1
  fi
}

claude_running() {
  # Claude Code CLI processes: brew/npm `claude`, the VS Code extension's
  # native binary, and bg-pty-host children. Excludes the Claude desktop app.
  ps -axo command= \
    | grep -vE 'Claude\.app|Claude Helper|grep' \
    | grep -qE '(^|/)claude(\.exe)?( |$)|@anthropic-ai/claude-code|native-binary/claude|bg-pty-host'
}

status() {
  if sleep_disabled; then echo "lid-close sleep: DISABLED (laptop stays awake)"; else echo "lid-close sleep: enabled (normal)"; fi
  if claude_running; then echo "claude code cli: running"; else echo "claude code cli: not running"; fi
  [ -e "$HOLD" ] && echo "manual hold: ON (run 'claude-awake off' to release)"
  if have_sudo_rule; then echo "sudoers rule: ok"; else echo "sudoers rule: MISSING ($SUDOERS)"; fi
  if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then echo "launch agent: loaded"; else echo "launch agent: not loaded"; fi
}

daemon() {
  local misses=0
  trap 'log "daemon exiting"; [ -e "$HOLD" ] || set_switch 0; exit 0' TERM INT EXIT
  log "daemon started (poll=${POLL}s grace=$((POLL*GRACE))s)"
  while :; do
    if [ -e "$HOLD" ] || claude_running; then
      misses=0
      sleep_disabled || set_switch 1
    else
      misses=$((misses+1))
      if [ "$misses" -ge "$GRACE" ] && sleep_disabled; then set_switch 0; fi
    fi
    sleep "$POLL"
  done
}

write_plist() {
  local self; self=$(readlink -f "$0")
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$self</string><string>daemon</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
  plutil -lint "$PLIST" >/dev/null
}

install_agent() {
  if ! have_sudo_rule; then
    cat <<MSG
The passwordless pmset rule is missing. Run this once (it asks for your password):

  printf '%s\n' '$(id -un) ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset -a disablesleep 0' \\
    | sudo tee $SUDOERS >/dev/null && sudo chmod 0440 $SUDOERS && sudo visudo -c -f $SUDOERS

then re-run: claude-awake install
MSG
    return 1
  fi
  write_plist
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
  launchctl bootstrap "gui/$(id -u)" "$PLIST" && echo "launch agent loaded: $LABEL" && status
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
  rm -f "$PLIST" "$HOLD"; set_switch 0
  echo "agent unloaded; sleep re-enabled. To remove the sudo rule: sudo rm $SUDOERS"
}

case "${1:-status}" in
  status)    status ;;
  on)        touch "$HOLD"; set_switch 1 && echo "held awake until 'claude-awake off'" ;;
  off)       rm -f "$HOLD"; set_switch 0 ;;
  daemon)    daemon ;;
  install)   install_agent ;;
  uninstall) uninstall_agent ;;
  *) sed -n '2,15p' "$0"; exit 2 ;;
esac
